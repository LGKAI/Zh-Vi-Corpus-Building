        "triplet_index": 0,
        "chu_han": "患晉祖之鎮太原也",
        "phien_am": "hoạn Tăn-Tồ chi trần Thái-nguyên dã",
        "dich_nghia_gloss": "sợ tăn-tồ trăn đất thái-nguyên"
      },
      {
        "triplet_index": 1,
        "chu_han": "地近契丹恃兵跋扈",
