      },
      {
        "triplet_index": 4,
        "chu_han": "或以不給吾是以始而駭也",
        "phien_am": "hoặc dĩ bất cấp, ngô thị dĩ thủy nhi hãi dã.",
        "dich_nghia_gloss": "có khi không đủ dùng, tôi sợ lúc đầu là vì thê"
      },
      {
        "triplet_index": 5,
