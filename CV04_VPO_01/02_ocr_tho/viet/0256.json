      {
        "triplet_index": 0,
        "chu_han": "夫人之言非一端也",
        "phien_am": "phù nhân chi ngôn, phi nhất đoan dã",
        "dich_nghia_gloss": "Lời nói không phải chỉ có một lõi mà ra"
      },
      {
        "triplet_index": 1,
        "chu_han": "巧辭縱橫而可喜",
        "phien_am": "Xảo từ túng hoành nhi khả hì",
        "dich_nghia_gloss": "Lời nói khéo, bay bướm, đế nghe"
      },
      {
        "triplet_index": 2,
        "chu_han": "忠言質樸而多訥",
        "phien_am": "trung ngón chãi phác nhi đa nội",
        "dich_nghia_gloss": "Lời trung-trực chất-phác, khó nghe"
      },
      {
        "triplet_index": 3,
        "chu_han": "此非聽言之難難在聽者",
        "phien_am": "thứ phi thinh ngôn chi nan, nan tại thinh giả",
        "dich_nghia_gloss": "Đó không phải là nghe khó, khó là ở người nghe"
      },
      {
        "triplet_index": 4,
        "chu_han": "之明暗也諛言順意而易悅",
        "phien_am": "chi minh ám dã. Du ngôn thuận ý nhi dị duyệt",
        "dich_nghia_gloss": "sáng-suốt hay mê-muội lời nịnh vừa ý nên dễ làm vui"
      },
      {
        "triplet_index": 5,
        "chu_han": "直言逆耳而觸怒此非聽言之難",
        "phien_am": "trực ngôn nghịch nhĩ nhi súc nộ, thử phi thinh ngôn chi nan",
        "dich_nghia_gloss": "lời thắng chọc tai sinh giận-dữ, đó là không phải lời nói khó"
      },
      {
        "triplet_index": 6,
        "chu_han": "在聽者之賢愚也",
        "phien_am": "tại thính-giả chi hiền ngu dã",
        "dich_nghia_gloss": "Khó ở chỗ người nghc giỏi hay ngu vậy"
      },
      {
        "triplet_index": 7,
        "chu_han": "是皆未足為難也",
        "phien_am": "thị giai vị túc vi nan dã",
        "dich_nghia_gloss": "mà thẽ cũng chưa đủ là khó vậy"
