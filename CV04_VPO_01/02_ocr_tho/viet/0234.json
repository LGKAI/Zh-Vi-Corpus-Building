      {
        "triplet_index": 0,
        "chu_han": "語曰為君難者孰難哉",
        "phien_am": "Ngữ viết: vi quân nan giả thục nan tai",
        "dich_nghia_gloss": "Luận ngữ nói - làm vua khó, điều gì là khó hơn cả ?"
      },
      {
        "triplet_index": 1,
        "chu_han": "蓋莫難於用人夫用人之術",
        "phien_am": "Cái mạc nan ư dụng nhân. Phù dung nhân chi thuật",
        "dich_nghia_gloss": "khó là ở cách dùng người, cách dùng người, phải cho người"
      },
      {
        "triplet_index": 2,
        "chu_han": "任之必專信之必篤",
        "phien_am": "nhiệm chi tát chuyên, tin chỉ tài đốc",
        "dich_nghia_gloss": "có quyền và lin cần rất mực"
      },
      {
        "triplet_index": 3,
        "chu_han": "然後能盡其材而可共成事",
        "phien_am": "nhiên hậu năng tận kỳ tài nhi khả cộng thành sự",
        "dich_nghia_gloss": "sau mới khiến trồ hét lài và nên được việc"
      },
      {
        "triplet_index": 4,
        "chu_han": "及其失也任之欲專",
        "phien_am": "cập kỳ thất dã, nhiệm chi dục chuyên",
        "dich_nghia_gloss": "đền khi hỏng việc, mà lại vẫn muốn chuyên dùng"
      },
      {
        "triplet_index": 5,
        "chu_han": "則不復謀於人而拒絕羣議",
        "phien_am": "tắc bũi phục mưu ưa nhần nhi cự tuyệt quân nghị",
        "dich_nghia_gloss": "tít không bàn được với ai, phải bắt chấp dị nghị, ấy là"
      },
      {
        "triplet_index": 6,
        "chu_han": "是欲盡一人之用",
        "phien_am": "thị dục tận nhãi nhân chỉ dụng",
        "dich_nghia_gloss": "muốn dùng hết khả năng một người"
      },
      {
        "triplet_index": 7,
        "chu_han": "而先失衆人之心也",
        "phien_am": "nhi tiên thất chúng nhân chi tâm dũ",
        "dich_nghia_gloss": "mà trước đã bỏ hết lòng dân vậy"
      },
      {
        "triplet_index": 8,
        "chu_han": "信之欲篤則一切不疑",
        "phien_am": "Tin chi dục đốc, tắc nhất thiệt bất nghi",
