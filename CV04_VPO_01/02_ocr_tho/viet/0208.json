      },
      {
        "triplet_index": 5,
        "chu_han": "見足下之文章蓄之者",
        "phien_am": "Kiên túc-hạ chi văn-chương, súc chi giả,",
        "dich_nghia_gloss": "Thây văn chương bác uần-súc"
      },
      {
        "triplet_index": 6,
        "chu_han": "蓋六七年未嘗言",
