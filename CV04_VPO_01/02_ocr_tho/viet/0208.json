        "triplet_index": 0,
        "chu_han": "銜忍而不出諸口",
        "phien_am": "Hàm nhắn nhi bắt xuất chư khầu",
        "dich_nghia_gloss": "nhắn nại không nói ra nên công-lý khó tỏ rõ,"
      },
      {
        "triplet_index": 1,
        "chu_han": "以公道之難明而世之多嫌也",
