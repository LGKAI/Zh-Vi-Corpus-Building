  "layout_summary": {
    "layout_mode": "two_column_poetry",
    "phien_am_lines": [
      "442",
      "Tiết lăng chướng vụ thân vô dạng",
      "Tiên phất xuân phong 7? mã hữu tham.",
      "Đỉnh ngữ nguyện ôn 8% Trung Thống",
      "chiếu,",
      "Miễn giao ưu 9 quốc mỗi như đàm"
    ],
    "dich_nghia_lines": [
      "TIỀN SỨ BẮC MA HỢP, KIỀU NGUYÊN LÃNG (1)",
      "Hai ngôi sao sứ thần chiếu xuống trời nam,",
      "Ánh sáng dẫn theo cung độ (3) mỗi đêm diễu quanh ba vòng.",
      "Ơn thượng quốc sâu sắc dễ cảm tình người.",
      "Phong tục nước nhỏ đơu giảu thẹn lễ nghi - sơ suất.",
      "Cờ tiết mao vượt qua lam chướng, ngài vẫn bình an (3).",
      "Ngọn roi quất trong gió xuân, ingựa có ngựa kệm (4).",
      "Xin hãy ôn lại lời nói a chuông vạc s (3) trong tờ chiếu năm Trung",
      "Thống (6)",
      "Đề tránh cho nhau khỏi mối phiền clo nước s luôn luôn nung đốt",
      "trong lòng."
    ],
    "dich_tho_lines": [
      "Trời Nam, sao sít chiếu hai ngôi.",
      "Dẫn lỗi ba vòng, đêm sáng soi.",
      "Bên ấy, ơn sâu tình cảm động.",
      "Nơi dây, lễ bạc thẹn sơ sài.",
      "Gió xuân vi vút, vui kèm ngựa.",
      "Cừ tiết xông phạ, mừng khóc người.",
      "Trung Thống, chiều xưa, lời hãy nhỏ,",
      "Nỗi lo đất nước, dịu lòng tôi.",
      "TRẦN LÊ VĂN"
    ],
    "interlinear_triplets": []
  }
}