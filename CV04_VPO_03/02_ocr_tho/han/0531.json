    "chu_han_lines": [
      "得意工意。",
      "哄貞呵。",
      "功名庄重。",
      "富貴庄性。",
      "秦漢初箕。",
      "粘它閑夏。",
      "安皮分庫。",
      "剧准養身。",
      "屈寂嫩高。",
      "耨命山野。",
      "猿明朽喜。",
      "伴共些。",
      "永尾岸箕。",
      "身恶喜捨。",
      "清閑無事。",
      "撅削台花。",
      "蜍奉学丞。",
      "店香火。",
      "誦經念字。",
      "祝聖态求。",
      "三有四思。",
      "些願特把。",
      "念意域之。",
      "覺性光了。",
      "庄群彼此。",
      "争人執我。",
      "塵緣楼歇。",
      "是非庄兮。",
      "煉幾糁惡。",
      "店得衰打。",
      "性工塵世。",
      "庄管事世",
      "永永岸箕。"
    ],
