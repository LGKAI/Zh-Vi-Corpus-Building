    "chu_han_lines": [
      "學隊諸佛。",
      "朱特圆成。",
      "唱曲樂生。",
      "安禪潇洒。",
      "埃子金谷。",
      "平占包。",
      "侈醒職槐",
      "珠漓泥渚。",
      "谷哈身幻。",
      "庄恪浮雲。",
      "萬事皆空。",
      "似荒学把。",
      "完命耨細。",
      "景永岸箕",
      "篤志修行。",
      "絲繡締把。",
      "冷导庄渚",
      "與导座哈。",
      "吟四塔聰。",
      "兮之福奇。",
      "安身立命。",
      "時節因緣。",
      "割酷分米。",
      "油羅鴉个。",
      "身尼庄管。",
      "讨奴。",
      "地水火風。",
      "油羅變化。",
      "法身常住。",
      "普满太虚。",
      "顕赫目前。",
      "圆融。"
    ],
    "interlinear_triplets": []
  }
